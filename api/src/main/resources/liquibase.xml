	<!-- Uncomment the changeset below if you want to make the Item class persistable, 
		see also Item and MdrtbDaoTest -->
	<changeSet id="mdrtb-20230926" author="owais.hussain">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="report_data" />
			</not>
		</preConditions>
		<comment>
			Creating the report_data table
		</comment>
		<createTable tableName="report_data">
			<column name="report_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="location_id" type="int" />
			<column name="report_name" type="varchar(255)" />
			<column name="description" type="varchar(255)" />
			<column name="year" type="int" />
			<column name="quarter" type="int" />
			<column name="month" type="int" />
			<column name="report_type" type="varchar(50)" />
			<column name="report_status" type="varchar(50)" />
			<column defaultValueNumeric="0" name="creator" type="int">
				<constraints nullable="false" />
			</column>
			<column name="date_created" type="datetime">
				<constraints nullable="false" />
			</column>
			<column name="changed_by" type="int" />
			<column name="date_changed" type="datetime" />
			<column name="voided" defaultValueBoolean="false"
				type="boolean">
				<constraints nullable="false" />
			</column>
			<column name="voided_by" type="int" />
			<column name="date_voided" type="datetime" />
			<column name="void_reason" type="varchar(255)" />
			<column name="table_data" type="longtext" />
			<column name="uuid" type="char(38)">
				<constraints nullable="false" unique="true"></constraints>
			</column>
		</createTable>

		<addForeignKeyConstraint
			constraintName="report_data_location_fk" baseTableName="report_data"
			baseColumnNames="location_id" referencedTableName="location"
			referencedColumnNames="location_id" />
		<addForeignKeyConstraint
			constraintName="report_data_creator_fk" baseTableName="report_data"
			baseColumnNames="creator" referencedTableName="users"
			referencedColumnNames="user_id" />
		<addForeignKeyConstraint
			constraintName="report_data_changed_by_fk"
			baseTableName="report_data" baseColumnNames="changed_by"
			referencedTableName="users" referencedColumnNames="user_id" />
		<addForeignKeyConstraint
			constraintName="report_data_voided_by_fk" baseTableName="report_data"
			baseColumnNames="voided_by" referencedTableName="users"
			referencedColumnNames="user_id" />

	</changeSet>

	<changeSet id="labtest.-2018-05-08-1" author="owais.hussain">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="labtest_type" />
			</not>
		</preConditions>
		<comment>
			Creating the labtest_test_type table
		</comment>
		<createTable tableName="labtest_type">
			<column name="test_type_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="name" defaultValue="" type="varchar(255)">
				<constraints nullable="false" />
			</column>
			<column name="short_name" type="varchar(20)" />
			<column name="test_group" type="varchar(20)">
				<!-- Name of the group that this test type belongs to. For example, Radiology, Bacteriology. This is an Enumeration in Object
					model -->
				<constraints nullable="false" />
			</column>
			<column defaultValueBoolean="true" name="requires_specimen" type="boolean">
				<constraints nullable="false" />
			</column>
			<column name="reference_concept_id" type="int">
				<!-- Concept ID with which this test type maps to. Ideally, the class of this concept should be "Test" -->
				<constraints nullable="false" />
			</column>
			<column name="description" type="text">
				<constraints nullable="false" />
			</column>
			<column defaultValueNumeric="0" name="creator" type="int">
				<constraints nullable="false" />
			</column>
			<column name="date_created" type="datetime">
				<constraints nullable="false" />
			</column>
			<column name="changed_by" type="int" />
			<column name="date_changed" type="datetime" />
			<column defaultValueBoolean="false" name="retired" type="boolean">
				<constraints nullable="false" />
			</column>
			<column name="retired_by" type="int" />
			<column name="date_retired" type="datetime" />
			<column name="retire_reason" type="varchar(255)" />
			<column name="uuid" type="char(38)">
				<constraints nullable="false" unique="true"></constraints>
			</column>
		</createTable>
		<addForeignKeyConstraint constraintName="labtest_type_creator_fk"
			baseTableName="labtest_type" baseColumnNames="creator" referencedTableName="users" referencedColumnNames="user_id" />
		<addForeignKeyConstraint constraintName="labtest_type_reference_concept_fk"
			baseTableName="labtest_type" baseColumnNames="reference_concept_id" referencedTableName="concept"
			referencedColumnNames="concept_id" />
		<addForeignKeyConstraint constraintName="labtest_type_changed_by_fk"
			baseTableName="labtest_type" baseColumnNames="changed_by" referencedTableName="users"
			referencedColumnNames="user_id" />
		<addForeignKeyConstraint constraintName="labtest_type_retired_by_fk"
			baseTableName="labtest_type" baseColumnNames="retired_by" referencedTableName="users"
			referencedColumnNames="user_id" />
	</changeSet>


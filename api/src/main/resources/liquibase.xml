	<!--
		Localised UI strings for this module. Historically these lived only in the
		messages*.properties bundles that OpenMRS loads into its DefaultMessageSourceService.
		They are now mirrored into this table so that translations can be corrected in a running
		system without repackaging the omod. MdrtbActivator seeds any rows that are missing
		(it never overwrites rows that already exist) once this changeset has been applied, and
		MdrtbService.getMessage() serves every lookup from an in-memory cache over this table.

		'code' is capped at 190 characters so that the composite primary key stays inside the
		767 byte per-column index limit of InnoDB's COMPACT/REDUNDANT row formats on utf8mb4
		(190 * 4 = 760). The longest key currently shipped is 61 characters.
	-->
	<changeSet id="mdrtb-2026-08-02-message-properties" author="owais.hussain">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="message_properties" />
			</not>
		</preConditions>
		<comment>
			Creating the message_properties table
		</comment>
		<createTable tableName="message_properties">
			<column name="lang" type="varchar(20)">
				<constraints nullable="false" />
			</column>
			<column name="code" type="varchar(190)">
				<constraints nullable="false" />
			</column>
			<column name="message" type="text" />
		</createTable>

		<addPrimaryKey constraintName="message_properties_pk"
			tableName="message_properties" columnNames="lang, code" />
	</changeSet>

	<!--
		Lab test orders in this deployment are persisted as plain org.openmrs.Order, never as
		org.openmrs.TestOrder: commonlab_migrations.sql and the ETL job both insert lab orders into
		`orders` with order_type_id = 3 and never write a matching `test_order` row.
		As long as the Test Order type carries the core default 'org.openmrs.TestOrder', every lab
		test order fails with "The java type of an order must match that set on associated order
		type". Aligning the order type with the class this module actually creates fixes it.
		Consequence: the `test_order` table stays empty
	-->
	<changeSet id="mdrtb-2026-08-13-test-order-java-class" author="owais.hussain">
		<comment>
			Align order_type.java_class_name for 'Test Order' with org.openmrs.Order, the class this
			module persists lab test orders as.
		</comment>
		<sql>
			UPDATE order_type SET java_class_name = 'org.openmrs.Order' WHERE name = 'Test Order';
		</sql>
	</changeSet>

	<!--
		A LabTest had no link to the TB program episode it belongs to. The only program marker in
		the lab path was the PATIENT_PROGRAM_ID obs on the order's encounter: an unconstrained
		numeric obs holding an unenforced pointer into patient_program, so nothing stopped it going
		stale or pointing at a row that no longer exists.

		MdrtbServiceImpl.getSmearForms and its five siblings therefore could not filter lab tests by
		program at all, and returned every common lab test the patient has ever had, across every
		episode. On a re-treatment patient that puts the first episode's results on the second
		episode's TB03.

		patient_program_id is nullable on purpose: rows predating this column have no program until
		the backfill runs, and the foreign key means a row whose program cannot be resolved stays
		NULL rather than carrying a bad pointer. Counting those NULLs is how we size what the
		backfill could not resolve.
	-->
	<changeSet id="mdrtb-2026-09-01-patient-program" author="owais.hussain">
		<preConditions onFail="MARK_RAN">
			<not>
				<columnExists tableName="labtest_test" columnName="patient_program_id" />
			</not>
		</preConditions>
		<comment>
			Links the labtest_test to the respective patient_program_id to identify the set of tests which fell under that program
		</comment>
		<addColumn tableName="labtest_test">
			<column name="patient_program_id" type="int" />
		</addColumn>
		<addForeignKeyConstraint constraintName="labtest_test_patient_program_fk"
			baseTableName="labtest_test" baseColumnNames="patient_program_id"
			referencedTableName="patient_program" referencedColumnNames="patient_program_id" />
		<createIndex tableName="labtest_test" indexName="labtest_test_patient_program_idx">
			<column name="patient_program_id" />
		</createIndex>
	</changeSet>

